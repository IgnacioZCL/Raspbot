# Discord bot token from https://discord.com/developers/applications
DISCORD_TOKEN=YOUR_BOT_TOKEN_HERE

# Optional: override command prefix (default is !)
# PREFIX=!

# Optional: enable debug mode with a different prefix (#)
# DEBUG=TRUE

# Optional: YouTube cookies if YouTube blocks your IP
# YOUTUBE_COOKIES=

# Optional: Spotify credentials for richer metadata and playlist/album support
# Create an app at https://developer.spotify.com/dashboard
# SPOTIFY_CLIENT_ID=YOUR_SPOTIFY_CLIENT_ID
# SPOTIFY_CLIENT_SECRET=YOUR_SPOTIFY_CLIENT_SECRET
